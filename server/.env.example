# Copy to .env outside version control. Generate APP_KEY with:
# php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_ENV=production
APP_DEBUG=false
APP_KEY=replace-with-at-least-32-random-characters
APP_URL=https://toshizo.link/tsutsuura-api/api
APP_TIMEZONE=Asia/Tokyo

# Comma-separated exact browser origins. Native iOS requests normally have no Origin.
CORS_ALLOWED_ORIGINS=https://toshizo.link
# Only set this when requests arrive through a proxy you control.
TRUSTED_PROXIES=

# Use mysql for MySQL/MariaDB, or sqlite when no database service is provisioned.
DB_CONNECTION=sqlite
# SQLite: an absolute path outside the public document root, or a path relative to server/.
DB_DATABASE=storage/tsutsuura.sqlite
# MySQL/MariaDB settings (ignored for SQLite).
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
# Optional CA bundle for remote MySQL TLS. Local ConoHa databases commonly use localhost.
DB_SSL_CA=

# Private answer attachments. Keep this outside the public document root.
MEDIA_STORAGE_PATH=storage/answer-media
# These first three values are the shipped iOS protocol contract; do not change them.
# The default family quota is 2 GiB. Multipart uploads are throttled per user/IP.
ANSWER_AUDIO_MAX_BYTES=20971520
ANSWER_PHOTO_MAX_BYTES=10485760
ANSWER_PHOTO_MAX_COUNT=4
ANSWER_MEDIA_FAMILY_QUOTA_BYTES=2147483648
ANSWER_MEDIA_USER_UPLOADS_PER_HOUR=12
ANSWER_MEDIA_IP_UPLOADS_PER_HOUR=120

# Must stay within the iOS protected replay-record retention window (maximum 30).
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_PHONE_REQUESTS_PER_HOUR=5
OTP_EMAIL_REQUESTS_PER_HOUR=5
OTP_IP_REQUESTS_PER_HOUR=20
OTP_VERIFY_ATTEMPTS_PER_HOUR=50

# Device-based family setup works without any external authentication service.
SETUP_FAMILY_IP_REQUESTS_PER_HOUR=5
PAIRING_IP_ATTEMPTS_PER_HOUR=60
PAIRING_TTL_SECONDS=600

# Email verification uses native PHP mail(), delivered by this web host.
# Set "mail" after configuring a From mailbox on a domain you control and the
# host's mail transport. Production forbids "log" and exposed development codes.
EMAIL_DRIVER=disabled
EMAIL_FROM_ADDRESS=
EMAIL_DEV_EXPOSE=false

# Legacy SMS routes remain compatible with old installs; the new app uses email.
# Leave disabled to avoid third-party SMS entirely.
OTP_DRIVER=disabled
OTP_DEV_EXPOSE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_BASE=https://api.twilio.com

# Push is independently optional. Production forbids the "log" driver. To
# enable APNs, download one Apple Push Notifications Auth Key (.p8), store it
# outside public/, chmod it 600, and fill the Apple developer identifiers.
PUSH_DRIVER=disabled
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=
APNS_TOPIC=
